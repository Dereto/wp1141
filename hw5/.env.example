# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local development, you can use:
# - Local PostgreSQL: postgresql://postgres:password@localhost:5432/xclone?schema=public
# - Supabase: Get from your Supabase project settings > Database > Connection string
# - Vercel Postgres: Get from Vercel dashboard > Your project > Storage > Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/xclone?schema=public"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# Your app URL (change to your Vercel URL when deploying)
NEXTAUTH_URL=http://localhost:3000

# Generate a random secret key:
# Run: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# ============================================
# GOOGLE OAUTH
# ============================================
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to "Credentials" > "Create Credentials" > "OAuth client ID"
# 5. Application type: Web application
# 6. Authorized redirect URIs: 
#    - http://localhost:3000/api/auth/callback/google (for local)
#    - https://your-domain.vercel.app/api/auth/callback/google (for production)
# 7. Copy Client ID and Client Secret here
GOOGLE_CLIENT_ID=your-google-client-id-from-google-cloud-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-google-cloud-console

# ============================================
# GITHUB OAUTH
# ============================================
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Application name: X-Clone (or your choice)
# 4. Homepage URL: http://localhost:3000 (or your production URL)
# 5. Authorization callback URL:
#    - http://localhost:3000/api/auth/callback/github (for local)
#    - https://your-domain.vercel.app/api/auth/callback/github (for production)
# 6. Copy Client ID and generate Client Secret
GITHUB_CLIENT_ID=your-github-client-id-from-github-settings
GITHUB_CLIENT_SECRET=your-github-client-secret-from-github-settings

# ============================================
# PUSHER CONFIGURATION
# ============================================
# 1. Go to https://dashboard.pusher.com/
# 2. Create a new app (or use existing)
# 3. Select cluster (e.g., us2, eu, ap-southeast-1)
# 4. Go to "App Keys" tab
# 5. Copy App ID, Key, Secret, and Cluster
PUSHER_APP_ID=your-pusher-app-id-from-pusher-dashboard
PUSHER_KEY=your-pusher-key-from-pusher-dashboard
PUSHER_SECRET=your-pusher-secret-from-pusher-dashboard
PUSHER_CLUSTER=us2

# ============================================
# PUSHER CLIENT (PUBLIC - EXPOSED TO BROWSER)
# ============================================
# These are the same as above, but prefixed with NEXT_PUBLIC_
# so they're available in the browser
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key-from-pusher-dashboard
NEXT_PUBLIC_PUSHER_CLUSTER=us2

